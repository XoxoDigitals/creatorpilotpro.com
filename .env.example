# =============================================================================
# SocialCreatorPilot — environment variables
# Copy to `.env` and fill in. NEVER commit a real `.env`.
# =============================================================================

# --- Core infrastructure ---------------------------------------------------
# PostgreSQL 16 connection string (used by @scp/db / Prisma, api, and the
# worker's pg-boss queues — no Redis in this stack, docs/02).
DATABASE_URL="postgresql://scp:scp@localhost:5432/scp?schema=public"

# --- Secrets ---------------------------------------------------------------
# AES-256-GCM master key for encrypting authPayload / ai_keys / SMTP+Telegram
# secrets at rest (docs/03 cross-cutting). 32-byte key, base64 or hex. Never in DB.
MASTER_KEY="change-me-32-byte-random-key-base64"
# Session/cookie signing secret for the web auth (Auth.js credentials).
SESSION_SECRET="change-me-long-random-string"

# --- API server (apps/api) -------------------------------------------------
# Port the NestJS/Fastify API listens on.
API_PORT="4000"
# Host/bind address for the API.
API_HOST="0.0.0.0"
# Comma-separated list of allowed CORS origins (the web app origin(s)).
CORS_ORIGINS="http://localhost:3000"
# Application version surfaced by GET /api/v1/health.
APP_VERSION="0.0.0"

# --- Web app (apps/web) ----------------------------------------------------
# Base URL of the API as seen by the browser. NEXT_PUBLIC_ = exposed to client.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Backend origin the Next server proxies /api/* to (server-to-server). The
# browser always uses the same-origin /api rewrite so the session cookie stays
# first-party. Defaults to http://localhost:4000 if unset.
API_ORIGIN="http://localhost:4000"
# Port the Next.js server listens on (dev/prod).
WEB_PORT="3000"
# Public site origin (no trailing slash) — used on legal/data-deletion pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Legal / compliance placeholders shown on /legal/* (also editable in
# apps/web/src/lib/legal-meta.ts). Fill before Meta/Google/TikTok app review.
NEXT_PUBLIC_LEGAL_COMPANY_NAME="[Company Name]"
NEXT_PUBLIC_LEGAL_EMAIL="privacy@example.com"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
NEXT_PUBLIC_LEGAL_ADDRESS="[Street Address], [City], [Country]"
NEXT_PUBLIC_LEGAL_EFFECTIVE_DATE="2026-01-01"

# --- Worker (apps/worker) --------------------------------------------------
# Default per-worker concurrency override (optional; queues have their own).
WORKER_CONCURRENCY="4"

# --- Seeding (packages/db seed.ts) -----------------------------------------
# Password for the seeded Owner user (email saboor@xoxodigitals.com).
SEED_OWNER_PASSWORD="change-me-owner-password"

# --- Deployment (deploy/) --------------------------------------------------
# Public domain for Caddy auto-TLS (deploy/Caddyfile, deploy/setup.sh).
DOMAIN="scp.example.com"
# Postgres credentials used by deploy/setup.sh when provisioning the VPS.
POSTGRES_USER="scp"
POSTGRES_PASSWORD="change-me-postgres-password"
POSTGRES_DB="scp"

# --- External integrations (added in later phases; documented now) ---------
# Media storage backend: `local` (hot tier under STORAGE_ROOT) or `gdrive`
# (Google Drive is the system of record; local files are short-lived temp only).
# Prefer Settings → General → “Google Drive media library” → Storage backend.
# STORAGE_BACKEND below is optional bootstrap/fallback only (not required).
# STORAGE_BACKEND="local"
# STORAGE_ROOT=".data/storage"
#
# --- Google Drive media library ----------------------------------------------
# Where to configure: Settings → General → “Google Drive media library”
# (choose Local vs Google Drive, then OAuth OR service account; encrypted in DB).
# Env vars below remain an optional bootstrap/fallback for API + worker.
# You do NOT need to edit .env when configuring Drive from the dashboard.
#
# Option A — OAuth (best for a personal My Drive owned by the same user):
#   1. Google Cloud Console → enable “Google Drive API”.
#   2. Create an OAuth 2.0 Client (Desktop or Web).
#   3. Authorize once with scope:
#        https://www.googleapis.com/auth/drive.file
#      and copy the refresh token into Settings (or GOOGLE_DRIVE_REFRESH_TOKEN).
#   4. Create a root folder; paste its id (.../folders/{id}).
#   5. In Settings, set Storage backend to “Google Drive” and Save.
#
# Option B — Service account (no browser OAuth; share the folder with the SA):
#   1. Google Cloud Console → IAM → Service Accounts → Create service account.
#   2. Create a JSON key; enable “Google Drive API” for the project.
#   3. Share the library root folder with client_email as Editor
#      (…@….iam.gserviceaccount.com), or add the SA to a Shared Drive.
#   4. Paste the JSON key (or client_email + private_key) + root folder ID in Settings.
#   5. Set Storage backend to “Google Drive” and Save (no .env edit needed).
#
# Confirm status: Settings → General, or GET /api/v1/storage/status.
#
# GOOGLE_DRIVE_AUTH_MODE=""   # optional: oauth | service_account
# GOOGLE_DRIVE_CLIENT_ID=""
# GOOGLE_DRIVE_CLIENT_SECRET=""
# GOOGLE_DRIVE_REFRESH_TOKEN=""
# GOOGLE_DRIVE_CLIENT_EMAIL=""
# GOOGLE_DRIVE_PRIVATE_KEY="" # PEM; use \n for newlines in .env
# GOOGLE_DRIVE_ROOT_FOLDER_ID=""
# AI providers (key pool is DB-managed & encrypted; these are optional bootstrap).
# Text tasks default to gemini-3.5-flash-lite with automatic fallback through
# cheaper Flash-Lite / Flash models when a model 404s ("no longer available").
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# YouTube Data API key for competitor channel resolve/poll (prefer Settings → Platform Apps).
# YOUTUBE_DATA_API_KEY=""
# Kokoro TTS is in-process (`kokoro-js`) or HTTP — not a CLI binary.
# KOKORO_URL="http://localhost:8880"
#
# --- Media CLI tools (optional on Linux) ------------------------------------
# On Ubuntu/VPS: install via apt/pip/pipx and leave these UNSET. The worker
# resolves binaries automatically:
#   1. env var if set and the file exists (Windows local override)
#   2. PATH
#   3. /usr/bin, /usr/local/bin, ~/.local/bin (and Windows fallbacks)
# Set an absolute path only when you need to override auto-detect.
# FFMPEG_PATH=""
# FFPROBE_PATH=""
# YT_DLP_PATH=""
# WHISPER_BIN=""
# DEMUCS_PATH=""
# EDGE_TTS_BIN=""
# PostQued (TikTok bridge) API base.
# POSTQUED_API_URL="https://api.postqued.com"
# Telegram bot + SMTP for notifications.
# TELEGRAM_BOT_TOKEN=""
# SMTP_URL=""
