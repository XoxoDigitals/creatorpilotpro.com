// SocialCreatorPilot — Prisma schema
// Phase 0 base schema: docs/03 Domain 1 (Identity & Access) + Domain 8 subset
// (system_settings, notifications, job_runs). Remaining domains land in later phases.
// Conventions (docs/03): cuid() ids, createdAt/updatedAt everywhere, soft-delete
// (deletedAt) on user-facing entities, helpful @@index entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domain 1 — Identity & Access
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  REVIEWER
  WORKER
  ANALYST
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String?
  role           Role       @default(WORKER)
  status         UserStatus @default(ACTIVE)
  telegramChatId String?
  lastLoginAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  sessions       Session[]
  apiTokens      ApiToken[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  socialAccounts SocialAccount[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Auth.js DB session store.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

/// Scoped API tokens for programmatic access (e.g. worker upload scripts).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  scopes     String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("api_tokens")
}

/// Append-only audit trail (docs/03 Domain 1). No updatedAt / deletedAt by design.
model AuditLog {
  id         String  @id @default(cuid())
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Domain 2 — Connections & Channel Profiles (docs/03 Domain 2, Phase 1a)
// ---------------------------------------------------------------------------

enum Platform {
  YOUTUBE
  FACEBOOK
  TIKTOK
}

enum AccountKind {
  YT_CHANNEL
  FB_PAGE
  FB_BM_PAGE
  TIKTOK_ACCOUNT
}

/// Connection/token health surfaced by the monitor (docs/03 Domain 2, FR-A4).
enum ConnectionStatus {
  HEALTHY
  EXPIRING
  BROKEN
}

/// How the account publishes: PostQued bridge or the owner's own platform app.
enum ConnectionMethod {
  POSTQUED
  OWN_APP
}

/// Content pipeline chosen at connect time (docs/11 §1); decides workspace tabs.
enum AccountContentType {
  AI
  REPURPOSED
  MIXED
}

/// A connected social channel/page/account (docs/03 Domain 2).
/// `authPayload` is an AES-256-GCM envelope (never returned by the API): PostQued
/// accounts store `{pqAccountId, workspaceId}`; OAuth accounts store a token bundle.
model SocialAccount {
  id               String             @id @default(cuid())
  platform         Platform
  kind             AccountKind
  externalId       String
  name             String
  handle           String?
  avatarUrl        String?
  authPayload      String? // enc envelope; nullable until authorized
  tokenExpiresAt   DateTime?
  connectionStatus ConnectionStatus   @default(HEALTHY)
  connectionMethod ConnectionMethod
  contentType      AccountContentType @default(AI)
  dramasEnabled    Boolean            @default(false)
  monetized        Boolean            @default(false)
  paused           Boolean            @default(false)
  timezone         String             @default("UTC")

  addedById String?
  addedBy   User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  profile ChannelProfile?

  @@unique([platform, externalId])
  @@index([platform])
  @@index([connectionStatus])
  @@index([deletedAt])
  @@map("social_accounts")
}

/// 1:1 channel profile: AI prompts, styles, publish defaults, scheduling prefs
/// (docs/03 Domain 2). `schedulingPrefs` shape documented in docs/11 §1 wizard.
model ChannelProfile {
  id        String        @id @default(cuid())
  accountId String        @unique
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  masterPrompt        String   @default("")
  writingStyle        String   @default("")
  narrationStyle      String   @default("")
  language            String   @default("en")
  voiceSettings       Json     @default("{}")
  titleTemplate       String   @default("")
  descriptionTemplate String   @default("")
  defaultTags         String[] @default([])
  aiLabelDefault      Boolean  @default(true)
  approvalPolicy      Json     @default("{}")
  schedulingPrefs     Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("channel_profiles")
}

// ---------------------------------------------------------------------------
// Domain 6 — AI Providers & Keys (docs/03 Domain 6, docs/05 §4)
// ---------------------------------------------------------------------------

enum AiProviderKind {
  TEXT
  TTS
  MULTIMODAL
}

enum AiKeyStatus {
  ACTIVE
  COOLDOWN
  EXHAUSTED
  DISABLED
}

/// An AI capability provider (gemini/openai/kokoro/…). baseConfig holds
/// non-secret provider config (base URL, default models). Secrets live on keys.
model AiProvider {
  id         String         @id @default(cuid())
  name       String         @unique
  kind       AiProviderKind
  enabled    Boolean        @default(true)
  baseConfig Json           @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys AiKey[]

  @@map("ai_providers")
}

/// A single API key in a provider's pool. The secret is AES-256-GCM encrypted
/// (keyEnc, `v1:<iv>:<tag>:<ciphertext>`); only the last-4 is kept in clear for
/// display. keyEnc is NEVER returned by the API (docs/08 §2, write-only from UI).
model AiKey {
  id            String       @id @default(cuid())
  providerId    String
  provider      AiProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label         String
  keyEnc        String
  keyLast4      String
  priority      Int          @default(100)
  status        AiKeyStatus  @default(ACTIVE)
  cooldownUntil DateTime?
  limits        Json         @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, priority])
  @@index([status])
  @@map("ai_keys")
}

// ---------------------------------------------------------------------------
// Domain 8 — System (subset for Phase 0)
// ---------------------------------------------------------------------------

/// Global key/value config: Drive accounts, storage thresholds, notification
/// config, feature flags, TTS default, kill-switches (docs/03 Domain 8).
model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum NotificationChannel {
  INAPP
  TELEGRAM
  EMAIL
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // TODO(task#7+): add incident relation when Domain 7 (incidents) lands.
  incidentId String?
  type       String
  payload    Json
  channels   NotificationChannel[] @default([])
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([incidentId])
  @@map("notifications")
}

enum JobRunStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

/// Mirror of pg-boss job history kept ~30 days for the ops dashboard (docs/03 Domain 8).
model JobRun {
  id         String       @id @default(cuid())
  queue      String
  jobName    String
  entityId   String?
  status     JobRunStatus @default(WAITING)
  startedAt  DateTime?
  finishedAt DateTime?
  error      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue, status])
  @@index([entityId])
  @@index([createdAt])
  @@map("job_runs")
}
