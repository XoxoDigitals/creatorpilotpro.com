// SocialCreatorPilot — Prisma schema
// Phase 0 base schema: docs/03 Domain 1 (Identity & Access) + Domain 8 subset
// (system_settings, notifications, job_runs). Remaining domains land in later phases.
// Conventions (docs/03): cuid() ids, createdAt/updatedAt everywhere, soft-delete
// (deletedAt) on user-facing entities, helpful @@index entries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domain 1 — Identity & Access
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  REVIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String
  name           String?
  role           Role       @default(REVIEWER)
  status         UserStatus @default(ACTIVE)
  telegramChatId String?
  lastLoginAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  sessions       Session[]
  apiTokens      ApiToken[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  socialAccounts SocialAccount[]
  accountAccess         AccountAccess[]
  decidedIdeas          Idea[]       @relation("decidedIdeas")
  workerTasks           WorkerTask[] @relation("workerTasks")
  productivitySnapshots WorkerProductivitySnapshot[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// Explicit SocialAccount grants for REVIEWER. OWNER and ADMIN ignore grants and see all.
model AccountAccess {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, accountId])
  @@index([userId])
  @@index([accountId])
  @@map("account_access")
}

/// Auth.js DB session store.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

/// Scoped API tokens for programmatic access (e.g. worker upload scripts).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  scopes     String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("api_tokens")
}

/// Append-only audit trail (docs/03 Domain 1). No updatedAt / deletedAt by design.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  at         DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Domain 2 — Connections & Channel Profiles (docs/03 Domain 2, Phase 1a)
// ---------------------------------------------------------------------------

enum Platform {
  YOUTUBE
  FACEBOOK
  TIKTOK
}

enum AccountKind {
  YT_CHANNEL
  FB_PAGE
  FB_BM_PAGE
  TIKTOK_ACCOUNT
}

/// Connection/token health surfaced by the monitor (docs/03 Domain 2, FR-A4).
enum ConnectionStatus {
  HEALTHY
  EXPIRING
  BROKEN
}

/// How the account publishes: the owner's own platform app, or manual mode
/// (the Owner uploads to the platform by hand — we deliver the rendered file).
/// POSTQUED is kept for backwards compatibility with pre-Phase 9 data.
enum ConnectionMethod {
  POSTQUED
  OWN_APP
  MANUAL
}

/// Content pipeline chosen at connect time (docs/11 §1); decides workspace tabs.
enum AccountContentType {
  AI
  REPURPOSED
  MIXED
}

/// A connected social channel/page/account (docs/03 Domain 2).
/// `authPayload` is an AES-256-GCM envelope (never returned by the API): PostQued
/// accounts store `{pqAccountId, workspaceId}`; OAuth accounts store a token bundle.
model SocialAccount {
  id               String             @id @default(cuid())
  platform         Platform
  kind             AccountKind
  externalId       String
  name             String
  handle           String?
  avatarUrl        String?
  authPayload      String? // enc envelope; nullable until authorized
  tokenExpiresAt   DateTime?
  connectionStatus ConnectionStatus   @default(HEALTHY)
  connectionMethod ConnectionMethod
  contentType      AccountContentType @default(AI)
  dramasEnabled    Boolean            @default(false)
  monetized        Boolean            @default(false)
  paused           Boolean            @default(false)
  pausedReason     String?            // set when the strike counter auto-pauses
  copyrightStrikeCount Int            @default(0)
  timezone         String             @default("Asia/Karachi")

  addedById String?
  addedBy   User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  accessGrants        AccountAccess[]
  profile             ChannelProfile?
  publishTargets      PublishTarget[]
  scheduleSlots       ScheduleSlot[]
  incidents           Incident[]
  watchedSources      WatchedSource[]
  competitorChannels  CompetitorChannel[]
  ideas               Idea[]
  dramaSeries         DramaSeries[]
  workerTasks         WorkerTask[]
  metricSnapshots     MetricSnapshotAccount[]
  bestPostingHours    BestPostingHour[]

  @@unique([platform, externalId])
  @@index([platform])
  @@index([connectionStatus])
  @@index([deletedAt])
  @@map("social_accounts")
}

/// 1:1 channel profile: AI prompts, styles, publish defaults, scheduling prefs
/// (docs/03 Domain 2). `schedulingPrefs` shape documented in docs/11 §1 wizard.
model ChannelProfile {
  id        String        @id @default(cuid())
  accountId String        @unique
  account   SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  masterPrompt        String   @default("")
  writingStyle        String   @default("")
  narrationStyle      String   @default("")
  /// Structured brand/style questionnaire answers; composed into masterPrompt
  /// (and style fields) unless the owner overrides the freeform prompt.
  styleProfile        Json     @default("{}")
  language            String   @default("en")
  voiceSettings       Json     @default("{}")
  titleTemplate       String   @default("")
  descriptionTemplate String   @default("")
  /// Owner-authored thumbnail style/template; package generation matches this.
  thumbnailReferencePrompt String @default("")
  /// Owner-authored animation / video-generation guidelines; package scenes match this.
  animationReferencePrompt String @default("")
  defaultTags         String[] @default([])
  aiLabelDefault      Boolean  @default(true)
  approvalPolicy      Json     @default("{}")
  schedulingPrefs     Json     @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("channel_profiles")
}

// ---------------------------------------------------------------------------
// Domain 3 — Sources & Ingestion (docs/03 Domain 3, Phase 2)
// ---------------------------------------------------------------------------

/// A watched source (a Kuaishou profile poller) or a bulk-URL import batch
/// (a GENERIC_URL source that does not poll). Both feed source_videos.
enum WatchedSourceType {
  KUAISHOU_PROFILE
  GENERIC_URL
}

/// Watcher health (docs/04 §5): auto-pauses to ERROR after repeated failures.
enum WatchedSourceStatus {
  ACTIVE
  PAUSED
  ERROR
}

/// Per-source-video download lifecycle (docs/03 Domain 3).
enum DownloadStatus {
  PENDING
  DOWNLOADING
  DONE
  FAILED
  SKIPPED_DUPLICATE
}

/// A polled Kuaishou profile or a bulk-import batch (docs/03 Domain 3).
/// `trimStartMs` (default 500) is the ingest first-frames trim. `targetAccountId`
/// binds ingested videos to the account that will repurpose them.
model WatchedSource {
  id                  String              @id @default(cuid())
  type                WatchedSourceType
  url                 String
  label               String?
  checkIntervalMin    Int                 @default(360)
  trimStartMs         Int                 @default(500)
  lastCheckedAt       DateTime?
  status              WatchedSourceStatus @default(ACTIVE)
  errorNote           String?
  consecutiveFailures Int                 @default(0)

  targetAccountId String?
  targetAccount   SocialAccount? @relation(fields: [targetAccountId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  videos SourceVideo[]

  @@index([status])
  @@index([targetAccountId])
  @@index([deletedAt])
  @@map("watched_sources")
}

/// A single discovered/imported source video (docs/03 Domain 3). Deduped by
/// (watchedSourceId, sourcePlatformId) at insert time; after download, exact
/// md5 / perceptual near-dup checks are scoped to the same targetAccountId
/// **and** a non-deleted WatchedSource (same file may be imported on different
/// SocialAccounts, or re-imported after the source is removed).
/// `nearDuplicateOfId` self-references the item this was flagged as a dup of.
model SourceVideo {
  id                  String         @id @default(cuid())
  watchedSourceId     String?
  watchedSource       WatchedSource? @relation(fields: [watchedSourceId], references: [id], onDelete: Cascade)
  sourceUrl           String
  sourcePlatformId    String
  uploaderName        String?
  title               String?
  durationSec         Float?
  publishedAt         DateTime?
  perceptualHash      String?
  md5                 String?
  downloadStatus      DownloadStatus @default(PENDING)
  // Live download progress (docs/04 §2). Updated (throttled) by the DOWNLOAD
  // processor from yt-dlp's progress stream so the UI can show a live bar+ETA.
  downloadPercent     Float          @default(0)   // 0..100
  downloadEtaSec      Int?                          // seconds remaining, when known
  downloadSpeedBps    Int?                          // bytes/sec, when known
  rightsNote          String?
  rightsConfirmedById String?
  nearDuplicateOfId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItems ContentItem[]

  @@unique([watchedSourceId, sourcePlatformId])
  @@index([perceptualHash])
  @@index([downloadStatus])
  @@map("source_videos")
}

// ---------------------------------------------------------------------------
// Domain 4 — Content Core (docs/03 Domain 4, Phase 1b)
// ---------------------------------------------------------------------------

/// Origin pipeline of a content item (docs/03 Domain 4).
enum ContentItemType {
  REPURPOSED
  WORKER_PRODUCED
  DRAMA_EPISODE
  MANUAL_UPLOAD
}

/// content_items state machine (docs/03 Domain 4, docs/04 §4). Illegal
/// transitions are rejected + audited in the service layer, not by triggers.
enum ContentItemStatus {
  INGESTED
  REVIEW_PENDING
  APPROVED
  ANALYZING
  SCRIPT_READY
  SCRIPT_APPROVED
  TTS_DONE
  RENDERED
  METADATA_READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  DRAFT
  REJECTED
  FAILED
}

/// Media artifact kinds attached to a content item (docs/03 Domain 4).
enum AssetKind {
  ORIGINAL
  PROCESSED
  VOICEOVER
  BG_AUDIO
  FINAL
  THUMBNAIL
  SUBTITLE
}

/// Where an asset's bytes physically live across the tiered store (docs/02 §6).
enum StorageState {
  LOCAL
  UPLOADING
  DRIVE
  BOTH
  EVICTED
}

/// The central video project entity (docs/03 Domain 4). `sourceVideoId`,
/// `ideaId`, `episodeId` are FKs to Domain 3/5 rows.
model ContentItem {
  id            String            @id @default(cuid())
  type          ContentItemType
  sourceVideoId String?
  sourceVideo   SourceVideo?      @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  ideaId        String?
  idea          Idea?             @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  episodeId     String?
  episode       DramaEpisode?     @relation("episodeIdRef", fields: [episodeId], references: [id], onDelete: SetNull)
  title         String
  status        ContentItemStatus @default(INGESTED)
  statusReason  String?
  reviewedById  String?
  currentStep   Json              @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (user-facing entity)

  assets         Asset[]
  publishTargets PublishTarget[]
  incidents      Incident[]
  workerTask     WorkerTask?
  dramaEpisode   DramaEpisode?  @relation("episodeContent")
  suggestions    PostSuggestion[]

  @@index([status])
  @@index([type])
  @@index([ideaId])
  @@index([episodeId])
  @@index([deletedAt])
  @@map("content_items")
}

/// A media file belonging to a content item, tracked across storage tiers
/// (docs/03 Domain 4). `localPath` is relative to the storage hot-tier root.
model Asset {
  id            String       @id @default(cuid())
  contentItemId String
  contentItem   ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  kind          AssetKind
  localPath     String?
  driveFileId   String?
  md5           String?
  bytes         BigInt?
  durationSec   Float?
  width         Int?
  height        Int?
  storageState  StorageState @default(LOCAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentItemId, kind])
  @@index([storageState])
  @@map("assets")
}

/// Cross-post mode for a target (docs/06 §3). NOW dispatches immediately;
/// FIXED/QUEUE_SLOT/RANDOM_WINDOW resolve a concrete `scheduledAt`.
enum ScheduleMode {
  NOW
  FIXED
  QUEUE_SLOT
  RANDOM_WINDOW
}

/// Lifecycle of a single account publish target (docs/03 Domain 4, docs/06 §4).
enum PublishTargetStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  DRAFT
}

/// One content item → many targets = cross-posting (docs/03 Domain 4). Each
/// target resolves its own metadata, schedules on its account's rules, and
/// fails/retries independently. `metadataOverride` holds final per-account
/// title/description/tags; `lastError` mirrors the most recent failure payload.
model PublishTarget {
  id               String              @id @default(cuid())
  contentItemId    String
  contentItem      ContentItem         @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  accountId        String
  account          SocialAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metadataOverride Json                @default("{}")
  scheduleMode     ScheduleMode        @default(QUEUE_SLOT)
  scheduledAt      DateTime?
  status           PublishTargetStatus @default(PENDING)
  platformPostId   String?
  publishedAt      DateTime?
  lastError        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts        PublishAttempt[]
  incidents       Incident[]
  metricSnapshots MetricSnapshotPost[]

  @@index([contentItemId])
  @@index([accountId])
  @@index([status, scheduledAt])
  @@map("publish_targets")
}

// ---------------------------------------------------------------------------
// Domain 7 — Scheduling, Publishing, Incidents (docs/03 Domain 7, Phase 1b)
// ---------------------------------------------------------------------------

/// Per-account slot rules the planner expands into concrete publish slots
/// (docs/06 §3). `rule` is rrule-style (daily/weekly/monthly/custom dates);
/// `timeWindows` is [{start,end,randomize}] in the account timezone.
model ScheduleSlot {
  id          String        @id @default(cuid())
  accountId   String
  account     SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rule        Json          @default("{}")
  timeWindows Json          @default("[]")
  active      Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, active])
  @@map("schedule_slots")
}

/// Outcome class of a publish attempt, driving the retry matrix (docs/06 §4).
enum PublishAttemptOutcome {
  SUCCESS
  RETRYABLE_ERROR
  TERMINAL_ERROR
}

/// Append-only history of publish attempts (docs/03 Domain 7; retained
/// forever — small). One row per adapter.publish() invocation.
model PublishAttempt {
  id              String                 @id @default(cuid())
  publishTargetId String
  publishTarget   PublishTarget          @relation(fields: [publishTargetId], references: [id], onDelete: Cascade)
  attemptNo       Int
  startedAt       DateTime               @default(now())
  finishedAt      DateTime?
  outcome         PublishAttemptOutcome?
  errorCode       String?
  errorPayload    Json?

  @@index([publishTargetId, attemptNo])
  @@map("publish_attempts")
}

/// What an incident is about (docs/03 Domain 7, docs/06 §4 error matrix).
enum IncidentKind {
  COPYRIGHT
  AUTH
  RATE_LIMIT
  PLATFORM_REJECT
  WATCHER
  STORAGE
  SYSTEM
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  ACKED
  RESOLVED
}

/// An operational incident surfaced in the Incident center (docs/03 Domain 7).
/// Optionally scoped to an account, content item, and/or publish target.
model Incident {
  id              String           @id @default(cuid())
  kind            IncidentKind
  severity        IncidentSeverity @default(MEDIUM)
  accountId       String?
  account         SocialAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contentItemId   String?
  contentItem     ContentItem?     @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  publishTargetId String?
  publishTarget   PublishTarget?   @relation(fields: [publishTargetId], references: [id], onDelete: SetNull)
  title           String
  detail          Json             @default("{}")
  status          IncidentStatus   @default(OPEN)
  resolvedById    String?
  resolvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  @@index([status, severity])
  @@index([accountId])
  @@index([kind])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Domain 5 — Research, Ideas, Tasks, Dramas (docs/03 Domain 5, Phase 4)
// ---------------------------------------------------------------------------

enum IdeaStatus {
  SUGGESTED
  APPROVED
  REJECTED
  IN_PRODUCTION
  UPLOADED
  PUBLISHED
}

/// Idea novelty relative to reference-channel research (AI owner flow MVP).
enum IdeaCategory {
  RELEVANT
  SIMILAR
  UNIQUE

  @@map("idea_category")
}

/// Creative-package lifecycle for the AI-only owner path (no WorkerTask required).
enum PackageStatus {
  NONE
  GENERATING
  READY
  DONE
  FAILED

  @@map("package_status")
}

/// Voiceover synth lifecycle for AI-owner packages (when presentation is voiceover).
enum VoiceoverStatus {
  NONE
  GENERATING
  READY
  FAILED

  @@map("voiceover_status")
}

/// Audio-first narration package pipeline stage (script → voice → transcript → visuals).
enum PackageStage {
  NONE
  SCRIPT
  VOICE
  TRANSCRIPT
  VISUALS
  READY
  FAILED

  @@map("package_stage")
}

enum WorkerTaskStatus {
  ASSIGNED
  IN_PROGRESS
  UPLOADED
  REVISION_REQUESTED
  DONE
}

enum TranscriptSource {
  CAPTIONS
  WHISPER
  NONE
}

enum CompetitorChannelStatus {
  ACTIVE
  PAUSED
  ERROR

  @@map("competitor_channel_status")
}

/// How a tracked YouTube channel is used: competitor research vs inspiration source.
enum CompetitorChannelRole {
  COMPETITOR
  SOURCE

  @@map("competitor_channel_role")
}

enum DramaSeriesStatus {
  PLANNING
  BIBLE_GENERATING
  BIBLE_READY
  IN_PRODUCTION
  COMPLETE
  FAILED

  @@map("drama_series_status")
}

enum DramaEpisodeStatus {
  PENDING
  GENERATING
  GENERATED
  IN_PRODUCTION
  UPLOADED
  PUBLISHED
  FAILED

  @@map("drama_episode_status")
}

/// A YouTube channel tracked for competitor research (docs/03 Domain 5).
/// Polls recent uploads and fetches transcripts for idea generation.
model CompetitorChannel {
  id                  String                   @id @default(cuid())
  ownAccountId        String
  ownAccount          SocialAccount            @relation(fields: [ownAccountId], references: [id], onDelete: Cascade)
  youtubeChannelId    String
  /// Original pasted URL or @handle used when adding the channel (MVP: YouTube only).
  channelUrl          String?
  name                String
  role                CompetitorChannelRole    @default(COMPETITOR)
  /// Default daily polling for newly added reference channels.
  checkIntervalMin    Int                      @default(1440)
  lastCheckedAt       DateTime?
  consecutiveFailures Int                      @default(0)
  status              CompetitorChannelStatus  @default(ACTIVE)
  errorNote           String?

  /// Deterministic + optional AI insights from title/views analysis (channel memory).
  performanceMemory     Json?
  performanceAnalyzedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  videos CompetitorVideo[]

  @@unique([ownAccountId, youtubeChannelId])
  @@index([status])
  @@index([deletedAt])
  @@map("competitor_channels")
}

/// A fetched video from a competitor channel (docs/03 Domain 5).
/// Transcripts are YouTube captions first, Whisper fallback if available.
model CompetitorVideo {
  id                   String              @id @default(cuid())
  competitorChannelId  String
  competitorChannel    CompetitorChannel   @relation(fields: [competitorChannelId], references: [id], onDelete: Cascade)
  videoId              String
  title                String
  views                BigInt              @default(0)
  publishedAt          DateTime?
  durationSec          Float?
  transcript           String?
  transcriptSource     TranscriptSource    @default(NONE)
  fetchedAt            DateTime            @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([competitorChannelId, videoId])
  @@index([competitorChannelId])
  @@map("competitor_videos")
}

/// A content idea generated from competitor research (docs/03 Domain 5).
/// Kanban: SUGGESTED → APPROVED/REJECTED → IN_PRODUCTION → UPLOADED → PUBLISHED.
model Idea {
  id                       String        @id @default(cuid())
  accountId                String
  account                  SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sourceCompetitorVideoIds String[]      @default([])
  title                    String
  angle                    String        @default("")
  hook                     String        @default("")
  rationale                String        @default("")
  category                 IdeaCategory?
  /// Predicted viral potential 0–100 from idea generation.
  viralScore               Int?
  status                   IdeaStatus    @default(SUGGESTED)
  packageStatus            PackageStatus @default(NONE)
  /// Owner-requested total video length (seconds) before package generation.
  requestedVideoDurationSec Int?
  /// Owner-requested per-clip length (seconds); typically 8 / 10 / 15.
  requestedClipDurationSec  Int?
  rejectionReason          String?
  decidedById              String?
  decidedBy                User?         @relation("decidedIdeas", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt                DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  brief        ProductionBrief?
  contentItems ContentItem[]
  workerTasks  WorkerTask[]     @relation("taskIdea")

  @@index([accountId, status])
  @@index([deletedAt])
  @@map("ideas")
}

/// A full production brief / creative package generated from an approved idea.
/// AI-only owner path: videoTitle, description, scene/animation prompts, thumbnail prompt.
/// Owner produces the video externally and uploads — no in-app render for this path.
model ProductionBrief {
  id                   String  @id @default(cuid())
  ideaId               String  @unique
  idea                 Idea    @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  researchSummary      String  @default("")
  script               String  @default("")
  /// English summary of non-English voiceover narration (empty when output language is English).
  englishSummary       String  @default("")
  /// Structured scenes: [{sceneIndex, imagePrompt, animationPrompt, negativePrompt?, dialogue, durationSec?}].
  sceneBreakdown       Json    @default("[]")
  characterPrompts     Json    @default("[]")
  editingInstructions  String  @default("")
  targetDurationSec    Int?
  videoTitle           String  @default("")
  videoDescription     String  @default("")
  /// Thumbnail prompt only (no generated image asset for MVP).
  thumbnailPrompt      String  @default("")
  /// TTS voiceover for voiceover/mixed presentation channels.
  voiceoverStatus      VoiceoverStatus @default(NONE)
  voiceoverLocalPath   String?
  /// Audio-first pipeline stage (SCRIPT → VOICE → TRANSCRIPT → VISUALS → READY).
  packageStage         PackageStage @default(NONE)
  /// Human-readable error from the failing stage (cleared on retry).
  packageStageError    String?
  /// Timestamped narration segments: [{startMs,endMs,text}].
  timedTranscript      Json    @default("[]")
  /// Optional on-disk SRT/VTT path for download.
  transcriptLocalPath  String?
  /// Edge (or other) voice id used for the package voiceover.
  voiceIdUsed          String?
  version              Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerTasks WorkerTask[]

  @@map("production_briefs")
}

/// A drama series with its bible and character sheets (docs/03 Domain 5).
/// Bible and character sheets generated by AI; character sheets immutable per
/// series (edits create a new version flagged on affected episodes).
model DramaSeries {
  id                 String            @id @default(cuid())
  accountId          String
  account            SocialAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title              String
  genre              String            @default("")
  theme              String            @default("")
  audience           String            @default("")
  episodeCount       Int
  episodeDurationSec Int               @default(60)
  styleReferences    String?
  seriesBible        Json?
  characterSheets    Json              @default("[]")
  status             DramaSeriesStatus @default(PLANNING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  episodes DramaEpisode[]

  @@index([accountId])
  @@index([status])
  @@index([deletedAt])
  @@map("drama_series")
}

/// A single episode of a drama series (docs/03 Domain 5). Generated on demand
/// with bible + character sheets + recaps of episodes 1..N-1 for consistency.
model DramaEpisode {
  id              String             @id @default(cuid())
  seriesId        String
  series          DramaSeries        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number          Int
  summary         String?
  script          String?
  scenePrompts    Json               @default("[]")
  narration       String?
  productionNotes String?
  recap           String?
  generatedAt     DateTime?
  contentItemId   String?            @unique
  contentItem     ContentItem?       @relation("episodeContent", fields: [contentItemId], references: [id], onDelete: SetNull)
  status          DramaEpisodeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workerTasks  WorkerTask[] @relation("taskEpisode")
  contentItems ContentItem[] @relation("episodeIdRef")

  @@unique([seriesId, number])
  @@index([seriesId])
  @@index([status])
  @@map("drama_episodes")
}

/// A task assigned to a worker: produce a video from a brief or episode
/// (docs/03 Domain 5). One active task per worker (configurable).
model WorkerTask {
  id            String           @id @default(cuid())
  briefId       String?
  brief         ProductionBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  episodeId     String?
  episode       DramaEpisode?    @relation("taskEpisode", fields: [episodeId], references: [id], onDelete: SetNull)
  ideaId        String?
  idea          Idea?            @relation("taskIdea", fields: [ideaId], references: [id], onDelete: SetNull)
  workerId      String
  worker        User             @relation("workerTasks", fields: [workerId], references: [id], onDelete: Cascade)
  accountId     String
  account       SocialAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  title         String
  status        WorkerTaskStatus @default(ASSIGNED)
  assignedAt    DateTime         @default(now())
  uploadedAt    DateTime?
  contentItemId String?           @unique
  contentItem   ContentItem?     @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  revisionNotes String[]         @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId, status])
  @@index([accountId])
  @@index([status])
  @@map("worker_tasks")
}

// ---------------------------------------------------------------------------
// Domain 6 — AI Providers & Keys (docs/03 Domain 6, docs/05 §4)
// ---------------------------------------------------------------------------

enum AiProviderKind {
  TEXT
  TTS
  MULTIMODAL
}

enum AiKeyStatus {
  ACTIVE
  COOLDOWN
  EXHAUSTED
  DISABLED
}

/// An AI capability provider (gemini/openai/kokoro/…). baseConfig holds
/// non-secret provider config (base URL, default models). Secrets live on keys.
model AiProvider {
  id         String         @id @default(cuid())
  name       String         @unique
  kind       AiProviderKind
  enabled    Boolean        @default(true)
  baseConfig Json           @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  keys AiKey[]

  @@map("ai_providers")
}

/// A single API key in a provider's pool. The secret is AES-256-GCM encrypted
/// (keyEnc, `v1:<iv>:<tag>:<ciphertext>`); only the last-4 is kept in clear for
/// display. keyEnc is NEVER returned by the API (docs/08 §2, write-only from UI).
///
/// Rolling usage windows (docs/05 §4) live inline: {minute,day} counters + their
/// window-start timestamps + lastUsedAt for LRU selection. `limits` holds the
/// per-key headroom (rpm/rpd/tpm) mirroring the provider's published free-tier
/// limits — editable per key.
model AiKey {
  id            String      @id @default(cuid())
  providerId    String
  provider      AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  label         String
  keyEnc        String
  keyLast4      String
  priority      Int         @default(100)
  status        AiKeyStatus @default(ACTIVE)
  cooldownUntil DateTime?
  limits        Json        @default("{}")

  minuteWindowStartAt DateTime?
  requestsInMinute    Int       @default(0)
  tokensInMinute      Int       @default(0)
  dayWindowStartAt    DateTime?
  requestsInDay       Int       @default(0)
  lastUsedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usageLogs AiUsageLog[]

  @@index([providerId, priority])
  @@index([status])
  @@index([providerId, status, lastUsedAt])
  @@map("ai_keys")
}

// ---------------------------------------------------------------------------
// Domain 7 — AI cache, usage log, prompt versions (docs/05 §5, §7)
// ---------------------------------------------------------------------------

/// Deterministic content cache in front of every provider call (docs/05 §5).
/// The `cacheKey` hashes together inputContentHash + task + model + promptVersion
/// + channelStyleVersion so prompt/style edits naturally invalidate the affected
/// entries. Cross-posting one video → analyzed once, only per-channel work per
/// channel. `hitCount`/`lastHitAt` fuel the cost dashboard.
model AiOutput {
  id            String    @id @default(cuid())
  cacheKey      String    @unique
  task          String
  providerId    String?
  model         String
  promptVersion Int       @default(1)
  output        Json
  audioRef      String?
  tokensIn      Int?
  tokensOut     Int?
  ttsSeconds    Float?
  contentItemId String?
  hitCount      Int       @default(0)
  lastHitAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([task, model])
  @@index([contentItemId])
  @@map("ai_outputs")
}

/// One row per provider call — the source of truth for the cost dashboard
/// (docs/05 §8) and for FR-C7 per-video cost visibility. Immutable log; no
/// updatedAt column. `cacheHit=true` rows record cache serves (0 tokens, 0 cost).
model AiUsageLog {
  id               String   @id @default(cuid())
  task             String
  providerId       String?
  keyId            String?
  key              AiKey?   @relation(fields: [keyId], references: [id], onDelete: SetNull)
  model            String
  contentItemId    String?
  cacheHit         Boolean  @default(false)
  tokensIn         Int?
  tokensOut        Int?
  ttsSeconds       Float?
  estimatedCostUsd Decimal? @db.Decimal(10, 6)
  errorClass       String?
  latencyMs        Int?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([providerId, createdAt])
  @@index([contentItemId])
  @@index([keyId])
  @@map("ai_usage_log")
}

/// Versioned master prompts + narration/writing style bodies (docs/05 §7).
/// A `null` accountId is a platform-wide default template for the task;
/// account-scoped rows are the channel master prompt or per-channel style
/// override. Exactly one row per (accountId, task, name) is `isActive`; version
/// increments on each edit so `AiOutput.promptVersion` invalidates cache
/// entries touched by the change.
model PromptVersion {
  id          String  @id @default(cuid())
  accountId   String?
  task        String
  name        String
  version     Int     @default(1)
  template    String
  schemaHint  Json?
  isActive    Boolean @default(true)
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, task, name, version])
  @@index([accountId, task, isActive])
  @@map("prompt_versions")
}

// ---------------------------------------------------------------------------
// Domain 9 — Analytics Snapshots (docs/07, Phase 5)
// ---------------------------------------------------------------------------

/// Daily per-account metrics pulled by the analytics sync job (docs/07 §1).
/// Dashboards read only this table — never call platform APIs directly.
model MetricSnapshotAccount {
  id           String        @id @default(cuid())
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  followers    Int           @default(0)
  views        Int           @default(0)
  uniqueViewers Int          @default(0)  // deduped viewer count
  watchTimeMin Int           @default(0)
  impressions  Int           @default(0)
  ctr          Float         @default(0)  // impressions → clicks, %
  revenue      Decimal       @default(0) @db.Decimal(10, 4)
  rpm          Decimal       @default(0) @db.Decimal(10, 4)
  engagements  Int           @default(0) // likes + comments + shares
  retentionRate Float        @default(0) // average % of video watched
  // Breakdown JSON blobs — shape:
  //   trafficCountries: [{ country: "US", views: 12345, pct: 45.2 }, ...]
  //   ageGroups: [{ range: "18-24", pct: 33.1 }, ...]
  //   genderSplit: { male: 60, female: 38, other: 2 }
  //   trafficSources: [{ source: "browse", views: 12345, pct: 45.2 }, ...]
  //   deviceSplit: [{ device: "mobile", pct: 78 }, ...]
  trafficCountries Json      @default("[]")
  ageGroups        Json      @default("[]")
  genderSplit      Json      @default("{}")
  trafficSources   Json      @default("[]")
  deviceSplit      Json      @default("[]")
  syncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, date])
  @@index([accountId])
  @@index([date])
  @@map("metric_snapshot_accounts")
}

/// Daily per-post metrics pulled by the analytics sync job (docs/07 §1).
model MetricSnapshotPost {
  id              String        @id @default(cuid())
  publishTargetId String
  publishTarget   PublishTarget @relation(fields: [publishTargetId], references: [id], onDelete: Cascade)
  accountId       String
  date            DateTime      @db.Date
  views           Int           @default(0)
  uniqueViewers   Int           @default(0)
  likes           Int           @default(0)
  comments        Int           @default(0)
  shares          Int           @default(0)
  saves           Int           @default(0)
  watchTimeMin    Int           @default(0)
  averageViewDurationSec Int    @default(0)
  impressions     Int           @default(0)
  ctr             Float         @default(0)
  retentionRate   Float         @default(0)
  retentionCurve  Json          @default("[]")
  trafficCountries Json         @default("[]")
  ageGroups        Json         @default("[]")
  genderSplit      Json         @default("{}")
  trafficSources   Json         @default("[]")
  deviceSplit      Json         @default("[]")
  syncedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publishTargetId, date])
  @@index([publishTargetId])
  @@index([accountId])
  @@index([date])
  @@map("metric_snapshot_posts")
}

/// Materialized daily rollup from ai_usage_log (docs/07). Avoids scanning
/// the raw log for the cost dashboard — sync job aggregates nightly.
model AiUsageDaily {
  id               String  @id @default(cuid())
  date             DateTime @db.Date
  providerId       String
  task             String
  totalCalls       Int     @default(0)
  cacheHits        Int     @default(0)
  tokensIn         Int     @default(0)
  tokensOut        Int     @default(0)
  ttsSeconds       Float   @default(0)
  estimatedCostUsd Decimal @default(0) @db.Decimal(10, 6)

  createdAt DateTime @default(now())

  @@unique([date, providerId, task])
  @@map("ai_usage_daily")
}

/// Weekly per-worker productivity rollup (docs/07). Managers see this on
/// the workers dashboard; workers see their own stats.
model WorkerProductivitySnapshot {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart              DateTime @db.Date
  tasksAssigned          Int      @default(0)
  tasksCompleted         Int      @default(0)
  medianHoursToComplete  Float?
  revisionRate           Float    @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
  @@map("worker_productivity_snapshots")
}

// ---------------------------------------------------------------------------
// Domain 10 — Phase 7 backlog (subtitles, A/B suggestions, learner)
// ---------------------------------------------------------------------------

enum PostSuggestionKind {
  TITLE
  THUMBNAIL_PROMPT
}

/// A/B suggestion variant for a content item (docs/10 backlog #10). The AI
/// generates 3 title candidates + 3 thumbnail prompts; the user picks one at
/// metadata time. `chosen` marks the accepted variant.
model PostSuggestion {
  id            String             @id @default(cuid())
  contentItemId String
  contentItem   ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  kind          PostSuggestionKind
  content       String
  rationale     String             @default("")
  chosen        Boolean            @default(false)
  rank          Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentItemId, kind])
  @@map("post_suggestions")
}

/// Per-account best posting hour learned from MetricSnapshotPost engagement.
/// The learner reads snapshots weekly and upserts one row per (account, day-of-week, hour)
/// so the scheduling engine can suggest strong slots.
model BestPostingHour {
  id         String @id @default(cuid())
  accountId  String
  account    SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayOfWeek  Int    // 0..6, Monday=0
  hour       Int    // 0..23 UTC
  score      Float  @default(0)  // higher is better
  sampleSize Int    @default(0)
  computedAt DateTime @default(now())

  @@unique([accountId, dayOfWeek, hour])
  @@index([accountId])
  @@map("best_posting_hours")
}

// ---------------------------------------------------------------------------
// Domain 8 — System (subset for Phase 0)
// ---------------------------------------------------------------------------

/// Global key/value config: Drive accounts, storage thresholds, notification
/// config, feature flags, TTS default, kill-switches (docs/03 Domain 8).
model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum NotificationChannel {
  INAPP
  TELEGRAM
  EMAIL
}

model Notification {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentId String?
  incident   Incident?             @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  type       String
  payload    Json
  channels   NotificationChannel[] @default([])
  readAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([incidentId])
  @@map("notifications")
}

enum JobRunStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

/// Mirror of pg-boss job history kept ~30 days for the ops dashboard (docs/03 Domain 8).
model JobRun {
  id         String       @id @default(cuid())
  queue      String
  jobName    String
  entityId   String?
  status     JobRunStatus @default(WAITING)
  startedAt  DateTime?
  finishedAt DateTime?
  error      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queue, status])
  @@index([entityId])
  @@index([createdAt])
  @@map("job_runs")
}
